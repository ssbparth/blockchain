# Blockchain Node (local Hardhat/Ganache or Polygon testnet)
RPC_URL=http://127.0.0.1:8545

# Smart Contract (deploy your Solidity contract and paste address here)
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Your wallet private key (use a test wallet only!)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ABI file path
ABI_PATH=abi.json

# Pinata IPFS (get keys from https://app.pinata.cloud)
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_API_KEY=your_pinata_secret_here
PINATA_JWT=your_pinata_jwt_here

# AI - Ollama local model
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Frontend CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
